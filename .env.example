# ===== Jarvis Glasses Assistant — Environment Variables =====
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- LLM API ---
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# --- Speech-to-Text (STT) ---
STT_API_KEY=
STT_API_URL=
STT_LANGUAGE=ru-RU

# --- Text-to-Speech (TTS) ---
TTS_API_KEY=
TTS_API_URL=
TTS_VOICE=

# --- General ---
APP_PORT=3000
APP_DEBUG=false
